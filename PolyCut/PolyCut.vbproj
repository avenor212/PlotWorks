<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>PolyCut</RootNamespace>
    <AssemblyName>PlotWorks</AssemblyName>
    <UseWPF>true</UseWPF>
    <Company>IridiumIO</Company>
    <Description>Plotter/Cutter GCode Generator for 3D printers</Description>
    <Copyright>Copyright © 2026</Copyright>
    <PackageProjectUrl>https://github.com/IridiumIO/PolyCut/</PackageProjectUrl>
    <ApplicationIcon>Resources\logo.ico</ApplicationIcon>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  
  

  <ItemGroup>
    <Compile Remove="Resources\Controls\**" />
    <EmbeddedResource Remove="Resources\Controls\**" />
    <None Remove="Resources\Controls\**" />
    <Page Remove="Resources\Controls\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\banner_dark.svg" />
    <None Remove="Resources\Localisation\de-DE.toml" />
    <None Remove="Resources\Localisation\en-AU.toml" />
    <None Remove="Resources\Localisation\fr-FR.toml" />
    <None Remove="Resources\Localisation\ja-JP.toml" />
    <None Remove="Resources\Localisation\zh-CN.toml" />
    <None Remove="Resources\logo.ico" />
    <None Remove="Resources\vtracer.exe" />
    <None Remove="Resources\Fonts\PolyCut Hershey Cursive.ttf" />
    <None Remove="Resources\Fonts\PolyCut Hershey Gothic English.ttf" />
    <None Remove="Resources\Fonts\PolyCut Hershey Roman Simplex.ttf" />
    <None Remove="Resources\Fonts\PolyCut Hershey Script Complex.ttf" />
    <None Remove="Resources\Fonts\PolyCut Hershey Script Simplex.ttf" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Localisation\de-DE.toml" />
    <EmbeddedResource Include="Resources\Localisation\en-AU.toml" />
    <EmbeddedResource Include="Resources\Localisation\fr-FR.toml" />
    <EmbeddedResource Include="Resources\Localisation\ja-JP.toml" />
    <EmbeddedResource Include="Resources\Localisation\zh-CN.toml" />
    <EmbeddedResource Include="Resources\vtracer.exe" />
    <Resource Include="Resources\banner_dark.svg" />
    <Resource Include="Resources\logo.ico" />
    <!-- CopyToOutputDirectory 只让文件进 bin\Debug|Release，publish 目录要另配
         CopyToPublishDirectory：BundledFontRegistry 按 <exe 目录>\Resources\Fonts 找字体，
         少了这一步发布包里没有单线字体，中文单线会整个失效。 -->
    <Content Include="Resources\Fonts\PolyCut Hershey Cursive.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Resources\Fonts\PolyCut Hershey Gothic English.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Resources\Fonts\PolyCut Hershey Roman Simplex.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Resources\Fonts\PolyCut Hershey Script Complex.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Resources\Fonts\PolyCut Hershey Script Simplex.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Import Include="System.Windows" />
    <Import Include="System.Windows.Controls" />
    <Import Include="System.Windows.Data" />
    <Import Include="System.Windows.Documents" />
    <Import Include="System.Windows.Input" />
    <Import Include="System.Windows.Media" />
    <Import Include="System.Windows.Media.Imaging" />
    <Import Include="System.Windows.Navigation" />
    <Import Include="System.Windows.Shapes" />
    <Import Include="LazyTranslate.LocalisationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Clipper2" Version="2.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="FamFamFam.Flags.Wpf" Version="1.2.1" />
    <PackageReference Include="FluentFTP" Version="54.2.1" />
    <PackageReference Include="gong-wpf-dragdrop" Version="4.0.0" />
    <PackageReference Include="IridiumIO.MVVM.VBSourceGenerators" Version="0.6.2" />
    <PackageReference Include="LazyTranslate" Version="0.1.6" />
    <PackageReference Include="LazyTranslate.CatalogueBuilder" Version="0.1.6" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2210.55" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.77" />
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <PackageReference Include="NuGet.Versioning" Version="7.9.0" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />
    <PackageReference Include="Svg" Version="3.4.6" />
    <PackageReference Include="WpfObservableRangeCollection" Version="2.2.2" />
    <PackageReference Include="ValueConverters" Version="3.0.26" />
    <PackageReference Include="WPF-UI" Version="4.3.0">
      <GeneratePathProperty>True</GeneratePathProperty>
    </PackageReference>
    <PackageReference Include="WPF-UI.DependencyInjection" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Extern\IxMilia.Converters\src\IxMilia.Converters\IxMilia.Converters.csproj" />
    <ProjectReference Include="..\Extern\IxMilia.Converters\src\IxMilia.Dxf\src\IxMilia.Dxf\IxMilia.Dxf.csproj" />
    <ProjectReference Include="..\PolyCut.Core\PolyCut.Core.vbproj" />
    <ProjectReference Include="..\PolyCut.RichCanvas\PolyCut.RichCanvas.vbproj" />
    <ProjectReference Include="..\PolyCut.Shared\PolyCut.Shared.vbproj" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <CopyDebugSymbolFilesFromPackages>true</CopyDebugSymbolFilesFromPackages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="UIComponents\Custom Elements\LabeledControl.xaml.vb">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\PreviewPage.xaml.vb">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\SettingsPage.xaml.vb">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>
  
  <Target Name="RenamePublishedExe" AfterTargets="Publish" Condition="'$(IsMonolithic)' == 'true'">
    <Move SourceFiles="$(PublishDir)PlotWorks.exe" DestinationFiles="$(PublishDir)PlotWorks.mono.exe" />

  </Target>
  
  <PropertyGroup>
    <FinalPublishDir>$(ProjectDir)bin\publish\FinalOutput\</FinalPublishDir>
  </PropertyGroup>

  <Target Name="MovePublishedFiles" AfterTargets="Publish">
    <Message Text="Moving published files to FinalOutput..." Importance="high" />

    <ItemGroup>
        <PublishedFiles Include="$(PublishDir)**\*" />
    </ItemGroup>

    <!-- 必须用 %(RecursiveDir) 重建相对路径：DestinationFolder 是单一目录，
         它会把所有文件平铺到 FinalOutput 根下，Resources\Fonts\*.ttf 就丢了层级，
         而 BundledFontRegistry 是按 <exe 目录>\Resources\Fonts 找字体的。 -->
    <Copy SourceFiles="@(PublishedFiles)"
          DestinationFiles="@(PublishedFiles->'$(FinalPublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <!-- PublishSingleFile 不会把 Content 项放进发布目录，单文件包里就没有字体。
         这里显式再搬一次，让两种发布方式（单文件 / 目录）都能拿到 Resources\Fonts。 -->
    <ItemGroup>
        <PublishedFontFiles Include="$(MSBuildProjectDirectory)\Resources\Fonts\*.ttf" />
    </ItemGroup>

    <Copy SourceFiles="@(PublishedFontFiles)"
          DestinationFolder="$(FinalPublishDir)Resources\Fonts\"
          SkipUnchangedFiles="true" />
  </Target>
</Project>

