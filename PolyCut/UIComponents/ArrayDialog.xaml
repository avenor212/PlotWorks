<ui:FluentWindow x:Class="ArrayDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="阵列复制"
                 Width="440"
                 Height="360"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 WindowBackdropType="None"
                 WindowStartupLocation="CenterOwner"
                 mc:Ignorable="d">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Margin="0 0 0 14"
                   Opacity="0.75"
                   Text="按行列复制选中的内容，原件保留在原位。"
                   TextWrapping="Wrap" />

        <Label Grid.Row="1" Grid.Column="0" Margin="0 0 12 8" VerticalAlignment="Center" Content="行数" />
        <TextBox x:Name="RowsTextBox" Grid.Row="1" Grid.Column="1" Margin="0 0 0 8" />

        <Label Grid.Row="2" Grid.Column="0" Margin="0 0 12 8" VerticalAlignment="Center" Content="列数" />
        <TextBox x:Name="ColumnsTextBox" Grid.Row="2" Grid.Column="1" Margin="0 0 0 8" />

        <Label Grid.Row="3" Grid.Column="0" Margin="0 0 12 8" VerticalAlignment="Center" Content="列间距 (mm)" />
        <TextBox x:Name="ColumnGapTextBox" Grid.Row="3" Grid.Column="1" Margin="0 0 0 8" />

        <Label Grid.Row="4" Grid.Column="0" Margin="0 0 12 8" VerticalAlignment="Center" Content="行间距 (mm)" />
        <TextBox x:Name="RowGapTextBox" Grid.Row="4" Grid.Column="1" Margin="0 0 0 8" />

        <TextBlock x:Name="SummaryText"
                   Grid.Row="5" Grid.ColumnSpan="2"
                   Margin="0 12 0 0"
                   Opacity="0.85"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2"
                    Margin="0 18 0 0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <ui:Button x:Name="CancelButton" Width="90" Height="32" Margin="0 0 10 0" Click="CancelButton_Click" Content="取消" />
            <ui:Button x:Name="OkButton" Width="90" Height="32" Appearance="Primary" Click="OkButton_Click" Content="生成" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
