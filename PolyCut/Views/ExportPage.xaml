<Page x:Class="ExportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:loc="clr-namespace:LazyTranslate;assembly=LazyTranslate"
      xmlns:local="clr-namespace:PolyCut"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="ExportPage"
      Margin="42"
      d:DataContext="{d:DesignInstance Type=local:ExportViewModel}"
      d:DesignHeight="700"
      d:DesignWidth="800"
      mc:Ignorable="d">
    <Grid>
        <StackPanel>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Orientation="Horizontal">

                <Button Width="220" Height="200" Command="{Binding SaveFileCommand}">

                    <Grid Height="170">

                        <ui:SymbolIcon Margin="0 0 0 40" FontSize="70" Symbol="Save20" />
                        <TextBlock Grid.Row="1"
                                   Margin="0 0 0 35" VerticalAlignment="Bottom"
                                   loc:L.Value="Save GCode" SnapsToDevicePixels="True" />

                    </Grid>

                </Button>
                <StackPanel Margin="50 0 0 0" Orientation="Vertical">

                    <Button Width="220" Height="200"
                            Padding="0"
                            Command="{Binding NetworkUploadCommand}">

                        <Button.ToolTip>
                            <ToolTip>
                                <TextBlock Width="200" loc:L.Value="Uploads the G-code to the A1 over FTPS, then starts printing over MQTT." TextWrapping="Wrap" />
                            </ToolTip>
                        </Button.ToolTip>

                        <Grid Height="200">

                            <ui:SymbolIcon Margin="0 0 0 40" FontSize="70" Symbol="Send20" />
                            <TextBlock Margin="0 0 0 55" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                       loc:L.Value="Send to A1" />
                            <Button Width="220" Height="50"
                                    VerticalAlignment="Bottom"
                                    Command="{Binding NetworkUploadPreviewCommand}">

                                <Grid Height="40">

                                    <ui:SymbolIcon HorizontalAlignment="Left" FontSize="30" Symbol="SendClock20" />
                                    <TextBlock Margin="40 0 0 0" VerticalAlignment="Center" loc:L.Value="Send Preview (A1)" />

                                </Grid>

                                <Button.ToolTip>
                                    <ToolTip>
                                        <TextBlock Width="200" loc:L.Value="Sends just the bounding box to the printer for preview, which runs in the travel height." TextWrapping="Wrap" />
                                    </ToolTip>
                                </Button.ToolTip>

                            </Button>
                        </Grid>

                    </Button>



                </StackPanel>


            </StackPanel>

            <StackPanel Width="490"
                        Margin="0 20 0 0" VerticalAlignment="Center"
                        Orientation="horizontal">
                <Label Width="80" VerticalAlignment="Center" loc:L.Value="File name: " />
                <ui:TextBox x:Name="OutputFileName" Width="410" Text="{Binding FilePath, Mode=TwoWay}" />
            </StackPanel>

            <Separator Margin="0 20" />

            <TextBlock Margin="0 -10 0 20"
                       loc:L.Value="Printer Configuration" FontSize="20"
                       Foreground="{StaticResource CardForeground}" />

            <Label loc:L.Context="3D Printer Host Type and address" loc:L.Value="Host Type" />

            <ComboBox x:Name="Protocol" SelectedIndex="0">
                <ComboBoxItem Content="Bambu Lab A1 (MQTT)" />
            </ComboBox>

            <Label Margin="0 10 0 0" loc:L.Context="Bambu Lab A1 Connection" loc:L.Value="Host Address" />
            <ui:TextBox x:Name="HostAddress" PlaceholderText="192.168.1.50" Text="{Binding MainVM.Printer.HostAddress, Mode=TwoWay}" />

            <Label Margin="0 10 0 0" loc:L.Context="Bambu Lab A1 Connection" loc:L.Value="Access Code" />
            <ui:TextBox x:Name="AccessCode" PlaceholderText="{loc:T 8 character access code}" Text="{Binding MainVM.Printer.AccessCode, Mode=TwoWay}" />

            <Label Margin="0 10 0 0" loc:L.Context="Bambu Lab A1 Connection" loc:L.Value="Serial Number" />
            <ui:TextBox x:Name="SerialNumber" PlaceholderText="{loc:T Printer serial number}" Text="{Binding MainVM.Printer.SerialNumber, Mode=TwoWay}" />

            <!-- A1 firmware rejects MQTT gcode_file, and project_file only unpacks without starting. Upload is manual-start only. -->
            <TextBlock Margin="0 10 0 0"
                       FontSize="11"
                       Foreground="#E81123"
                       Text="A1 不支持远程自动开始打印，上传后请在打印机屏幕上手动启动。"
                       TextWrapping="Wrap" />

        </StackPanel>

    </Grid>
</Page>
