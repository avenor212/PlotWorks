<Page x:Class="MonitorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:PolyCut"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      Title="MonitorPage"
      d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
      d:DesignHeight="700"
      d:DesignWidth="1000"
      Loaded="Page_Loaded"
      Margin="0,5,0,0"
      mc:Ignorable="d">

    <Grid Margin="24,18,24,18" RowDefinitions="Auto,Auto,*">

        <!--  ============================================================  -->
        <!--  CONNECTION BAR                                                 -->
        <!--  ============================================================  -->

        <ui:Card Grid.Row="0" Padding="14,10" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon FontSize="20" Symbol="PlugConnected20" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="Bambu Lab A1" />
                        <TextBlock FontSize="12"
                                   Opacity="0.65"
                                   Text="{Binding A1Service.ConnectionStatus}" />
                    </StackPanel>
                    <TextBlock Margin="20,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Opacity="0.5"
                               Text="{Binding A1Service.DeviceAddress}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button MinWidth="90"
                               Margin="0,0,8,0"
                               Appearance="Primary"
                               Click="Connect_Click">
                        <TextBlock Text="Connect" />
                    </ui:Button>
                    <ui:Button MinWidth="90" Click="Disconnect_Click">
                        <TextBlock Text="Disconnect" />
                    </ui:Button>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!--  ============================================================  -->
        <!--  CAMERA + STATUS  |  JOG DIAL                                   -->
        <!--  ============================================================  -->

        <Grid Grid.Row="1" Margin="0,0,0,0" ColumnDefinitions="Auto,*">

            <StackPanel Grid.Column="0" Width="360" VerticalAlignment="Top">

                <!--  Deliberately small camera placeholder. The A1 camera uses a private
                      TLS protocol on port 6000 and is not connected yet, so the WebView2
                      control stays collapsed until a stream source is added.  -->
                <Border Width="360"
                        Height="240"
                        Background="#1E1E1E"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid>
                        <wv2:WebView2 x:Name="webView" Visibility="Collapsed" />

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Margin="0,10,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Opacity="0.75"
                                       Text="Camera stream not connected" />
                            <TextBlock Width="280"
                                       Margin="0,6,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="11"
                                       Opacity="0.5"
                                       Text="The A1 does not expose RTSP. Video is intentionally left unconnected for now."
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ui:Card Margin="0,12,0,0" Padding="14,12">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Live status" />
                        <Grid Margin="0,8,0,0" ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" FontSize="12" Opacity="0.55" Text="State" />
                            <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12" Text="{Binding A1Service.GCodeState}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" FontSize="12" Opacity="0.55" Text="Nozzle" />
                            <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" Text="{Binding A1Service.NozzleTemperature}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" FontSize="12" Opacity="0.55" Text="Bed" />
                            <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12" Text="{Binding A1Service.BedTemperature}" />
                            <TextBlock Grid.Row="3" Grid.Column="0" FontSize="12" Opacity="0.55" Text="Progress" />
                            <TextBlock Grid.Row="3" Grid.Column="1" FontSize="12" Text="{Binding A1Service.PrintProgress}" />
                        </Grid>
                    </StackPanel>
                </ui:Card>
            </StackPanel>

            <!--  Jog control, grouped in one card  -->
            <ui:Card Grid.Column="1"
                     Margin="16,0,0,0"
                     Padding="20,16"
                     VerticalAlignment="Top">
                <StackPanel HorizontalAlignment="Center">

                    <TextBlock HorizontalAlignment="Center"
                               FontSize="18" FontWeight="SemiBold"
                               Text="Printer Control" />
                    <TextBlock MaxWidth="420"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Center"
                               FontSize="12"
                               Opacity="0.55"
                               Text="Jog the toolhead in X/Y. Pick a step, then tap a direction. Home returns to the origin (G28)."
                               TextAlignment="Center"
                               TextWrapping="Wrap" />

                    <StackPanel Margin="0,14,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Step" />
                        <ComboBox x:Name="JogStepCombo"
                                  Width="130" Margin="10,0,0,0"
                                  SelectedIndex="1"
                                  SelectionChanged="JogStepCombo_SelectionChanged">
                            <ComboBoxItem Content="0.1 mm" Tag="0.1" />
                            <ComboBoxItem Content="1 mm" Tag="1" />
                            <ComboBoxItem Content="10 mm" Tag="10" />
                        </ComboBox>
                    </StackPanel>

                    <Grid Width="250" Height="250" Margin="0,10,0,0" HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ui:Button Grid.Row="0" Grid.Column="1"
                                   Width="64" Height="64"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Command="{Binding JogCommand}" CommandParameter="Up">
                            <ui:SymbolIcon FontSize="20" Symbol="ArrowUp16" />
                        </ui:Button>

                        <ui:Button Grid.Row="1" Grid.Column="0"
                                   Width="64" Height="64"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Command="{Binding JogCommand}" CommandParameter="Left">
                            <ui:SymbolIcon FontSize="20" Symbol="ArrowLeft16" />
                        </ui:Button>

                        <ui:Button Grid.Row="1" Grid.Column="1"
                                   Width="78" Height="78"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Appearance="Primary"
                                   Command="{Binding HomePrinterCommand}">
                            <TextBlock FontSize="12" Text="Home" />
                        </ui:Button>

                        <ui:Button Grid.Row="1" Grid.Column="2"
                                   Width="64" Height="64"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Command="{Binding JogCommand}" CommandParameter="Right">
                            <ui:SymbolIcon FontSize="20" Symbol="ArrowRight16" />
                        </ui:Button>

                        <ui:Button Grid.Row="2" Grid.Column="1"
                                   Width="64" Height="64"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Command="{Binding JogCommand}" CommandParameter="Down">
                            <ui:SymbolIcon FontSize="20" Symbol="ArrowDown16" />
                        </ui:Button>
                    </Grid>

                    <StackPanel Margin="0,4,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                        <TextBlock FontSize="12" Opacity="0.6" Text="Tool" />
                        <TextBlock Margin="8,0,0,0" FontSize="12" Text="{Binding ToolX, StringFormat=X {0:F1}}" />
                        <TextBlock Margin="12,0,0,0" FontSize="12" Text="{Binding ToolY, StringFormat=Y {0:F1}}" />
                    </StackPanel>

                    <ui:Button Margin="0,10,0,0" Width="260" Height="38"
                               Command="{Binding CaptureReferencePointCommand}">
                        <TextBlock HorizontalAlignment="Center" Text="Capture reference point" />
                    </ui:Button>

                    <Separator Margin="0,16,0,0" />

                    <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center"
                               FontSize="12" Opacity="0.55"
                               Text="Calibrate the tracked position" />
                    <Grid Margin="0,6,0,0" Width="260" ColumnDefinitions="Auto,*,6,Auto,*">
                        <TextBlock VerticalAlignment="Center" Text="X" />
                        <ui:TextBox Grid.Column="1" Margin="8,0,0,0"
                                    Text="{Binding CalibrationX, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="Y" />
                        <ui:TextBox Grid.Column="4" Margin="8,0,0,0"
                                    Text="{Binding CalibrationY, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                    <ui:Button Margin="0,6,0,0" Width="260" Height="34"
                               Command="{Binding ApplyPositionCalibrationCommand}">
                        <TextBlock HorizontalAlignment="Center" Text="Set as current position" />
                    </ui:Button>

                </StackPanel>
            </ui:Card>
        </Grid>

        <!--  ============================================================  -->
        <!--  LOG                                                            -->
        <!--  ============================================================  -->

        <Grid Grid.Row="2"
              Height="170"
              Margin="0,16,0,0"
              RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Log" />
                <ui:Button Grid.Column="1" Padding="10,2" Click="ClearLog_Click">
                    <TextBlock FontSize="12" Text="Clear" />
                </ui:Button>
            </Grid>

            <TextBox x:Name="LogBox"
                     Grid.Row="1"
                     Margin="0,6,0,0"
                     AcceptsReturn="True"
                     FontFamily="Consolas"
                     FontSize="12"
                     HorizontalScrollBarVisibility="Auto"
                     IsReadOnly="True"
                     Text="{Binding A1Service.LogText, Mode=OneWay}"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" />
        </Grid>
    </Grid>
</Page>
